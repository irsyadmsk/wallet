{
  "name": "wallet-motion",
  "private": true,
  "description": "Remotion sources for Wallet's welcome loop, feature tour and store promo. Not part of the Flutter build.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:welcome": "remotion render src/index.ts Welcome ../web/media/welcome.mp4 --crf 30",
    "render:tur": "remotion render src/index.ts Tur ../web/media/tur.mp4 --crf 23",
    "render:playstore": "remotion render src/index.ts PlayStore ../web/media/playstore.mp4 --crf 21",
    "render": "npm run render:welcome && npm run render:tur && npm run render:playstore"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
